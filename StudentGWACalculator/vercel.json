{
  "version": 2,
  "outputDirectory": "StudentGWACalculator/dist",
  "builds": [
    {
      "src": "StudentGWACalculator/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/StudentGWACalculator/index.html" }
  ]
}
